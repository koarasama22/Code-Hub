{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webapp",
  "compatibility_date": "2026-10-23",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // ファイル本体の保存先 (R2)
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "webapp-files"
    }
  ],
  // 転送メタデータの保存先 (D1)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "webapp-production",
      "database_id": "local-dev"
    }
  ]
}
